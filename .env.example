# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FINNHUB_API_KEY: For real-time market data (free tier available at finnhub.io)
FINNHUB_API_KEY=""

# POLYGON_API_KEY: For advanced aggregate data (free tier available at polygon.io)
POLYGON_API_KEY=""

# ALPHAVANTAGE_API_KEY: For technical indicators
ALPHAVANTAGE_API_KEY=""
